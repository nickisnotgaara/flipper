# Grist configuration
GRIST_SESSION_SECRET=flipper_grist_session_secret_2026_8chars_minimum_long_enough
APP_HOME_URL=http://localhost:8484
GRIST_DOMAIN=localhost
GRIST_SINGLE_ORG=flipper
GRIST_SUPPORT_ANON=true
GRIST_FORCE_LOGIN=false
GRIST_SANDBOX_FLAVOR=gvisor
GRIST_THROTTLE_CPU=true
GRIST_ENABLE_SERVICE_ACCOUNTS=true
GRIST_PAGE_TITLE_SUFFIX= — Flipper
GRIST_ORG_IN_PATH=false
DEBUG=1

# Postgres metadata
TYPEORM_DATABASE=grist
TYPEORM_USERNAME=grist
TYPEORM_PASSWORD=grist_secret_change_me
TYPEORM_HOST=grist-postgres
TYPEORM_LOGGING=false
TYPEORM_PORT=5432
TYPEORM_TYPE=postgres

# External attachments OFF for now (causes issues with first-run)
GRIST_EXTERNAL_ATTACHMENTS_MODE=

