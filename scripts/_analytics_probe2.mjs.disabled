const r = await fetch('http://localhost:3000/analytics', { redirect: 'manual' });
const b = await r.text();
console.log('status:', r.status, 'length:', b.length);
for (const p of ['rows\\":', 'columns\\":', 'pg_id', 'price_per_m2', 'sold_date', 'tableId', 'allTables', 'manualSort']) {
  const i = b.indexOf(p);
  if (i >= 0) {
    const ctx = b.substr(Math.max(0, i - 40), 200).replace(/[\n\r]/g, ' ');
    console.log(p, 'at', i, '—', JSON.stringify(ctx));
  } else {
    console.log(p, 'NOT FOUND');
  }
}
