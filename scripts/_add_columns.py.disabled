"""
Add columns to the 5 empty Парсинг tables, then bulk-insert data.
"""
import json
import sys
import time
import urllib.request
import urllib.parse
import psycopg2

GRIST_URL = 'http://localhost:8484'
GRIST_KEY = 'flipper_prod_c173df83d342e744aa1fa74bb80bd19a32f5f598d7e582c0c8d4561659290978'
DOC_ID = 'mDaHoGD6yahtxaqugwr5mK'

def grist_apply(actions):
    body = json.dumps(actions).encode()
    req = urllib.request.Request(
        f'{GRIST_URL}/api/docs/{DOC_ID}/apply',
        data=body,
        headers={'Authorization': f'Bearer {GRIST_KEY}', 'Content-Type': 'application/json'},
        method='POST',
    )
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read())

def grist_post_records(table, records):
    body = json.dumps({'records': records}).encode()
    req = urllib.request.Request(
        f'{GRIST_URL}/api/docs/{DOC_ID}/tables/{table}/records',
        data=body,
        headers={'Authorization': f'Bearer {GRIST_KEY}', 'Content-Type': 'application/json'},
        method='POST',
    )
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read())

def add_columns(table, cols):
    """Add a list of (colId, type) to a table in one BulkAddColumn call."""
    col_ids = [c[0] for c in cols]
    col_types = [c[1] for c in cols]
    return grist_apply([['BulkAddColumn', table, col_ids, col_types]])

