# Schema for Balans (aggregate)
BALANS_COLS = [
    ('filter_id', 'Numeric'),
    ('name', 'Text'),
    ('active_count', 'Numeric'),
    ('avg_price', 'Numeric'),
    ('min_price', 'Numeric'),
    ('max_price', 'Numeric'),
]

if sys.argv[1] == 'add':
    for tbl, cols in [
        ('Table2', ACTIVE_COLS),
        ('Table3', SOLD_COLS),
        ('Balans', BALANS_COLS),
        ('Offers_Parser', ACTIVE_COLS),
        ('Signals_Parser', ACTIVE_COLS),
    ]:
        try:
            r = add_columns(tbl, cols)
            print(f'  {tbl}: added {len(cols)} cols → {r}')
        except urllib.error.HTTPError as e:
            body = e.read().decode()
            print(f'  {tbl}: FAIL {e.code} {body[:200]}')
else:
    print('Usage: py _add_columns.py add', file=sys.stderr)
