ACTIVE_COLS = [
    ('source', 'Text'),
    ('pg_id', 'Numeric'),
    ('cian_id', 'Text'),
    ('external_id', 'Text'),
    ('url', 'Text'),
    ('house_id', 'Numeric'),
    ('cian_house_id', 'Numeric'),
    ('price', 'Numeric'),
    ('price_per_m2', 'Numeric'),
    ('area', 'Numeric'),
    ('rooms', 'Numeric'),
    ('floor_current', 'Numeric'),
    ('floor_total', 'Numeric'),
    ('metro_station', 'Text'),
    ('metro_walk_time', 'Numeric'),
    ('district', 'Text'),
    ('okrug', 'Text'),
    ('renovation', 'Text'),
    ('is_active', 'Bool'),
    ('days_in_exposition', 'Numeric'),
    ('total_views', 'Numeric'),
    ('unique_views', 'Numeric'),
    ('publish_date', 'Date'),
    ('filter_id', 'Numeric'),
    ('parsed_at', 'DateTime'),
    ('updated_at', 'DateTime'),
]

# Schema for SOLD ads (Table3 Аванс_Продано)
SOLD_COLS = [
    ('source', 'Text'),
    ('pg_id', 'Numeric'),
    ('external_id', 'Text'),
    ('url', 'Text'),
    ('house_id', 'Numeric'),
    ('cian_house_id', 'Numeric'),
    ('price', 'Numeric'),
    ('price_per_m2', 'Numeric'),
    ('area', 'Numeric'),
    ('rooms', 'Numeric'),
    ('floor_current', 'Numeric'),
    ('floor_total', 'Numeric'),
    ('renovation', 'Text'),
    ('exposition_days', 'Numeric'),
    ('publish_date', 'Date'),
    ('sold_date', 'Date'),
    ('parsed_at', 'DateTime'),
