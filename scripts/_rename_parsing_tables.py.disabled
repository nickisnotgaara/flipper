"""Rename *2 tables -> clean names in Парсинг doc."""
import json
import urllib.request
import urllib.parse

GRIST_URL = 'http://localhost:8484'
GRIST_KEY = 'flipper_prod_c173df83d342e744aa1fa74bb80bd19a32f5f598d7e582c0c8d4561659290978'
DOC_ID = 'mDaHoGD6yahtxaqugwr5mK'

def grist_sql(q):
    req = urllib.request.Request(
        f'{GRIST_URL}/api/docs/{DOC_ID}/sql?q=' + urllib.parse.quote(q),
        headers={'Authorization': f'Bearer {GRIST_KEY}'},
    )
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read())

def grist_apply(actions):
    body = json.dumps(actions)
    req = urllib.request.Request(
        f'{GRIST_URL}/api/docs/{DOC_ID}/apply',
        data=body.encode(),
        headers={'Authorization': f'Bearer {GRIST_KEY}', 'Content-Type': 'application/json'},
        method='POST',
    )
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read())

RENAMES = [
    ('FILTERS2',          'FILTERS2'),         # source name we'll re-use
    # Grist requires target name be unique; we'll try direct rename first,
    # but if a 'FILTERS' (old) still exists it'll fail. Round 5b DropTable
    # of FILTERS happened — but the импорт may have re-created. Let's
    # check first.
]

# Strategy: list current tables, then for each *2 table, attempt
# RenameTable. If it returns isModification=false (name collision),
# we know there's a stale original we need to drop first.
r = grist_sql("SELECT id, tableId FROM _grist_Tables")
existing = {row['fields']['id']: row['fields']['tableId'] for row in r['records']}
print('Existing tables:', list(existing.values()))

# Mapping: *2 -> clean name
plan = {
    'FILTERS2':         'FILTERS',
    'Balans2':          'Balans',
    'Offers_Parser2':   'Offers_Parser',
    'Signals_Parser2':  'Signals_Parser',
}

for src, dst in plan.items():
    if src not in existing.values():
        print(f'  SKIP {src}: not found')
        continue
    if dst in existing.values():
        # Collision: drop the old empty/stale one
        print(f'  COLLISION: {dst} already exists, dropping first')
        # ... actually let's just RenameTable and see what happens
    try:
        r = grist_apply([['RenameTable', src, dst]])
        print(f'  {src} -> {dst}: ret={r}')
    except urllib.error.HTTPError as e:
        body = e.read().decode()
        print(f'  {src} -> {dst}: FAIL {e.code} {body[:300]}')
        # If collision, drop the old
        if 'already exists' in body or 'isModification' in body:
            print(f'    trying drop {dst} first then rename')
            try:
                grist_apply([['RemoveTable', dst]])
                r2 = grist_apply([['RenameTable', src, dst]])
                print(f'    retry: {src} -> {dst}: ret={r2}')
            except urllib.error.HTTPError as e2:
                print(f'    drop+rename also failed: {e2.read().decode()[:200]}')
