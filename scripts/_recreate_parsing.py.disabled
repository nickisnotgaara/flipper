"""Drop + recreate 5 Парсинг tables with proper columns, then bulk-insert."""
import json
import sys
import time
import urllib.request
import urllib.parse
import psycopg2

GRIST_URL = 'http://localhost:8484'
GRIST_KEY = 'flipper_prod_c173df83d342e744aa1fa74bb80bd19a32f5f598d7e582c0c8d4561659290978'
DOC_ID = 'mDaHoGD6yahtxaqugwr5mK'

def grist_apply(actions):
    body = json.dumps(actions)
    req = urllib.request.Request(
        f'{GRIST_URL}/api/docs/{DOC_ID}/apply',
        data=body.encode(),
        headers={'Authorization': f'Bearer {GRIST_KEY}', 'Content-Type': 'application/json'},
        method='POST',
    )
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read())

def grist_post_records(table, records):
    body = json.dumps({'records': records})
    req = urllib.request.Request(
        f'{GRIST_URL}/api/docs/{DOC_ID}/tables/{table}/records',
        data=body.encode(),
        headers={'Authorization': f'Bearer {GRIST_KEY}', 'Content-Type': 'application/json'},
        method='POST',
    )
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read())

# Schemas
ACTIVE_COLS = [
    ('source', 'Text'),
    ('pg_id', 'Numeric'),
    ('cian_id', 'Text'),
    ('external_id', 'Text'),
    ('url', 'Text'),
    ('house_id', 'Numeric'),
    ('cian_house_id', 'Numeric'),
    ('price', 'Numeric'),
    ('price_per_m2', 'Numeric'),
    ('area', 'Numeric'),
    ('rooms', 'Numeric'),
    ('floor_current', 'Numeric'),
    ('floor_total', 'Numeric'),
    ('metro_station', 'Text'),
    ('metro_walk_time', 'Numeric'),
    ('district', 'Text'),
    ('okrug', 'Text'),
    ('renovation', 'Text'),
    ('is_active', 'Bool'),
    ('days_in_exposition', 'Numeric'),
    ('total_views', 'Numeric'),
    ('unique_views', 'Numeric'),
    ('publish_date', 'Date'),
    ('filter_id', 'Numeric'),
    ('parsed_at', 'DateTime'),
    ('updated_at', 'DateTime'),
]
SOLD_COLS = [
    ('source', 'Text'),
    ('pg_id', 'Numeric'),
    ('external_id', 'Text'),
    ('url', 'Text'),
    ('house_id', 'Numeric'),
    ('cian_house_id', 'Numeric'),
    ('price', 'Numeric'),
    ('price_per_m2', 'Numeric'),
    ('area', 'Numeric'),
    ('rooms', 'Numeric'),
    ('floor_current', 'Numeric'),
    ('floor_total', 'Numeric'),
    ('renovation', 'Text'),
    ('exposition_days', 'Numeric'),
    ('publish_date', 'Date'),
    ('sold_date', 'Date'),
    ('parsed_at', 'DateTime'),
]
BALANS_COLS = [
    ('filter_id', 'Numeric'),
    ('name', 'Text'),
    ('active_count', 'Numeric'),
    ('avg_price', 'Numeric'),
    ('min_price', 'Numeric'),
    ('max_price', 'Numeric'),
]

# === Step 1: drop+recreate all 5 tables in one apply call =================
print('[1] drop+recreate 5 tables in one apply call...', flush=True)
recreate_actions = []
for tbl, cols in [
    ('Table2', ACTIVE_COLS),
    ('Table3', SOLD_COLS),
    ('Balans', BALANS_COLS),
    ('Offers_Parser', ACTIVE_COLS),
    ('Signals_Parser', ACTIVE_COLS),
]:
    recreate_actions.append(['RemoveTable', tbl])
    col_specs = [{'id': cid, 'label': cid, 'type': ctype} for cid, ctype in cols]
    recreate_actions.append(['AddTable', tbl, col_specs])

t0 = time.time()
try:
    r = grist_apply(recreate_actions)
    print(f'  OK in {time.time()-t0:.1f}s — {r}', flush=True)
except urllib.error.HTTPError as e:
    body = e.read().decode()
    print(f'  FAIL {e.code} {body[:400]}', file=sys.stderr, flush=True)
    sys.exit(1)

# === Step 2: bulk-insert from local PG ====================================
conn = psycopg2.connect(host='127.0.0.1', port=5432, user='flipper', password='flipper_secret', dbname='flipper')
cur = conn.cursor()

def to_fields(d):
    out = {}
    for k, v in d.items():
        if k in {'id', 'manualSort'}:
            continue
        if v is None:
            continue
        if hasattr(v, 'isoformat'):
            out[k] = v.isoformat()
        else:
            out[k] = v
    return out

def bulk_insert(table, dicts, batch=500):
    added = 0
    t0 = time.time()
    for i in range(0, len(dicts), batch):
        chunk = [{'fields': to_fields(d)} for d in dicts[i:i+batch]]
        try:
            r = grist_post_records(table, chunk)
            added += len(r.get('records', []))
        except urllib.error.HTTPError as e:
            body = e.read().decode()
            print(f'   FAIL @ batch {i}: {e.code} {body[:200]}', flush=True)
            break
        elapsed = time.time() - t0
        rate = added / elapsed if elapsed > 0 else 0
        print(f'   {added}/{len(dicts)} ({rate:.0f}/s)', flush=True)
    return added

target = sys.argv[1] if len(sys.argv) > 1 else 'all'

if target in ('Table2', 'all'):
    print('\n[Table2] active_ads WHERE filter_id=6 (avans)...', flush=True)
    cur.execute("""
        SELECT source, cian_id, external_id, url, house_id, cian_house_id, price, price_per_m2,
               area, rooms, floor_current, floor_total, metro_station, metro_walk_time,
               district, okrug, renovation, is_active, days_in_exposition, total_views,
               unique_views, publish_date, filter_id, parsed_at, updated_at
        FROM active_ads WHERE filter_id = 6 ORDER BY id
    """)
    cols = [d[0] for d in cur.description]
    rows = [dict(zip(cols, row)) for row in cur.fetchall()]
    print(f'  fetched {len(rows)} from PG', flush=True)
    added = bulk_insert('Table2', rows)
    print(f'  DONE Table2: {added}', flush=True)

if target in ('Table3', 'all'):
    print('\n[Table3] sold_ads for avans houses (LIMIT 5000)...', flush=True)
    cur.execute("""
        SELECT s.source, s.external_id, s.url, s.house_id, s.cian_house_id, s.price,
               s.price_per_m2, s.area, s.rooms, s.floor_current, s.floor_total,
               s.renovation, s.exposition_days, s.publish_date, s.sold_date, s.parsed_at
        FROM sold_ads s
        WHERE s.house_id IN (SELECT house_id FROM active_ads WHERE filter_id = 6 AND house_id IS NOT NULL)
        ORDER BY s.sold_date DESC NULLS LAST, s.id DESC LIMIT 5000
    """)
    cols = [d[0] for d in cur.description]
    rows = [dict(zip(cols, row)) for row in cur.fetchall()]
    print(f'  fetched {len(rows)} from PG', flush=True)
    added = bulk_insert('Table3', rows)
    print(f'  DONE Table3: {added}', flush=True)

if target in ('Balans', 'all'):
    print('\n[Balans] per-filter stats...', flush=True)
    FILTERS_DEF = {
        1: 'offers, max_year=2000, dists=23-132',
        2: 'offers, min_year=2000, dists=23-132',
        3: 'offers, max_year=2000, dists=13-22',
        4: 'offers, min_year=2000, dists=13-22',
        5: 'signals, опека',
        6: 'avans, Т-банк|запрет долги',
    }
    cur.execute("""
        SELECT filter_id, COUNT(*), AVG(price)::bigint, MIN(price), MAX(price)
        FROM active_ads GROUP BY filter_id ORDER BY filter_id
    """)
    rows = []
    for fid, cnt, avg, mn, mx in cur.fetchall():
        rows.append({
            'filter_id': fid,
            'name': FILTERS_DEF.get(fid, f'filter_{fid}'),
            'active_count': cnt,
            'avg_price': int(avg) if avg else None,
            'min_price': mn,
            'max_price': mx,
        })
    print(f'  fetched {len(rows)}', flush=True)
    added = bulk_insert('Balans', rows)
    print(f'  DONE Balans: {added}', flush=True)

if target in ('Offers_Parser', 'all'):
    print('\n[Offers_Parser] active_ads WHERE filter_id IN (1,2,3,4)...', flush=True)
    cur.execute("""
        SELECT source, cian_id, external_id, url, house_id, cian_house_id, price, price_per_m2,
               area, rooms, floor_current, floor_total, metro_station, metro_walk_time,
               district, okrug, renovation, is_active, days_in_exposition, total_views,
               unique_views, publish_date, filter_id, parsed_at, updated_at
        FROM active_ads
        WHERE filter_id IN (1, 2, 3, 4) ORDER BY filter_id, id
    """)
    cols = [d[0] for d in cur.description]
    rows = [dict(zip(cols, row)) for row in cur.fetchall()]
    print(f'  fetched {len(rows)}', flush=True)
    added = bulk_insert('Offers_Parser', rows)
    print(f'  DONE Offers_Parser: {added}', flush=True)

if target in ('Signals_Parser', 'all'):
    print('\n[Signals_Parser] active_ads WHERE filter_id=5...', flush=True)
    cur.execute("""
        SELECT source, cian_id, external_id, url, house_id, cian_house_id, price, price_per_m2,
               area, rooms, floor_current, floor_total, metro_station, metro_walk_time,
               district, okrug, renovation, is_active, days_in_exposition, total_views,
               unique_views, publish_date, filter_id, parsed_at, updated_at
        FROM active_ads WHERE filter_id = 5 ORDER BY id
    """)
    cols = [d[0] for d in cur.description]
    rows = [dict(zip(cols, row)) for row in cur.fetchall()]
    print(f'  fetched {len(rows)}', flush=True)
    added = bulk_insert('Signals_Parser', rows)
    print(f'  DONE Signals_Parser: {added}', flush=True)

cur.close()
conn.close()
print('\nDONE', flush=True)
