"""
Re-seed Grist Table1 (Продано) with 5,000 most-recent sold_ads from local PG.

Steps:
  1. Pull last 5,000 sold_ads ordered by sold_date DESC from local PG.
  2. Get all current row ids in Grist Table1.
  3. BulkRemoveRecord all old rows.
  4. BulkAddRecord new rows from local PG.

Reuses: psycopg2 (already in env), urllib (stdlib), basic auth via API key.
"""
import json
import urllib.request
import urllib.parse
import psycopg2

GRIST_URL = 'http://localhost:8484'
GRIST_KEY = 'flipper_prod_c173df83d342e744aa1fa74bb80bd19a32f5f598d7e582c0c8d4561659290978'
DOC_ID = 'mDaHoGD6yahtxaqugwr5mK'  # Парсинг
TABLE = 'Table1'  # Продано

# --- 1. Read latest 5,000 sold from local PG -------------------------------
print('[1/4] reading 5,000 most-recent sold_ads from local PG...')
conn = psycopg2.connect(host='127.0.0.1', port=5432, user='flipper', password='flipper_secret', dbname='flipper')
cur = conn.cursor()
cur.execute("""
    SELECT id, source, external_id, url, house_id, price, price_per_m2, area,
           rooms, floor_current, floor_total, renovation, exposition_days,
           publish_date, sold_date
    FROM sold_ads
    WHERE source = 'cian_deactivated'
    ORDER BY sold_date DESC NULLS LAST, id DESC
    LIMIT 5000
""")
cols = [d[0] for d in cur.description]
rows = cur.fetchall()
print(f'   got {len(rows)} rows. columns: {cols}')
cur.close()
conn.close()

# --- 2. Get current Grist Table1 row ids (via SQL) -------------------------
print('[2/4] fetching current Grist Table1 row ids...')
def grist_sql(q):
    req = urllib.request.Request(
        f'{GRIST_URL}/api/docs/{DOC_ID}/sql?q=' + urllib.parse.quote(q),
        headers={'Authorization': f'Bearer {GRIST_KEY}'},
    )
    with urllib.request.urlopen(req) as r:
        return json.loads(r.read())

ids = grist_sql(f'SELECT id FROM {TABLE} ORDER BY id')
all_ids = [r['fields']['id'] for r in ids['records']]
print(f'   {len(all_ids)} current rows in Grist (will be removed)')

# --- 3. BulkRemoveRecord all old rows --------------------------------------
print(f'[3/4] bulk-removing {len(all_ids)} old rows...')
def grist_apply(actions):
    body = json.dumps(actions).encode()
    req = urllib.request.Request(
        f'{GRIST_URL}/api/docs/{DOC_ID}/apply',
        data=body,
        headers={'Authorization': f'Bearer {GRIST_KEY}', 'Content-Type': 'application/json'},
        method='POST',
    )
    with urllib.request.urlopen(req) as r:
        return json.loads(r.read())

# Split into chunks of 1000 to be safe
for i in range(0, len(all_ids), 1000):
    chunk = all_ids[i:i+1000]
    # Grist 1.7.17 wants 3 positional args: action, tableId, [rowIds]
    r = grist_apply([['BulkRemoveRecord', TABLE, chunk]])
    print(f'   removed {i+len(chunk)}/{len(all_ids)}: ret={r}')

# --- 4. BulkAddRecord new rows ---------------------------------------------
print(f'[4/4] bulk-adding {len(rows)} new rows...')
def grist_post_records(table, records):
    body = json.dumps({'records': records}).encode()
    req = urllib.request.Request(
        f'{GRIST_URL}/api/docs/{DOC_ID}/tables/{table}/records',
        data=body,
        headers={'Authorization': f'Bearer {GRIST_KEY}', 'Content-Type': 'application/json'},
        method='POST',
    )
    with urllib.request.urlopen(req) as r:
        return json.loads(r.read())

added = 0
# Grist reserved columns that we must NOT include in fields
RESERVED = {'id', 'manualSort'}
for i in range(0, len(rows), 500):
    chunk = rows[i:i+500]
    records = []
    for row in chunk:
        fields = {}
        for col, val in zip(cols, row):
            if col in RESERVED:
                continue
            if val is None:
                continue
            if hasattr(val, 'isoformat'):
                # date/datetime -> ISO string (Grist Date type)
                fields[col] = val.isoformat()
            else:
                fields[col] = val
        records.append({'fields': fields})
    try:
        r = grist_post_records(TABLE, records)
        added += len(r.get('records', []))
        print(f'   added {added}/{len(rows)}')
    except urllib.error.HTTPError as e:
        body = e.read().decode()
        print(f'   FAIL at batch {i}-{i+len(chunk)}: {e.code} {body[:500]}')
        for j, rec in enumerate(records):
            try:
                grist_post_records(TABLE, [rec])
                added += 1
            except urllib.error.HTTPError as e2:
                body2 = e2.read().decode()
                print(f'      bad row #{i+j}: {body2[:300]}')
        print(f'   one-by-one done: total added = {added}/{len(rows)}')
        break

print()
print(f'OK: Table1 now has {added} fresh rows.')
