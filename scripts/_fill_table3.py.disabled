"""Fill Table3 (Аванс_Продано) via external_id cross-link."""
import json
import urllib.request
import psycopg2

GRIST_URL = 'http://localhost:8484'
GRIST_KEY = 'flipper_prod_c173df83d342e744aa1fa74bb80bd19a32f5f598d7e582c0c8d4561659290978'
DOC_ID = 'mDaHoGD6yahtxaqugwr5mK'

def grist_post_records(table, records):
    body = json.dumps({'records': records})
    req = urllib.request.Request(
        f'{GRIST_URL}/api/docs/{DOC_ID}/tables/{table}/records',
        data=body.encode(),
        headers={'Authorization': f'Bearer {GRIST_KEY}', 'Content-Type': 'application/json'},
        method='POST',
    )
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read())

conn = psycopg2.connect(host='127.0.0.1', port=5432, user='flipper', password='flipper_secret', dbname='flipper')
cur = conn.cursor()
cur.execute("""
    SELECT s.source, s.external_id, s.url, s.house_id, s.cian_house_id, s.price,
           s.price_per_m2, s.area, s.rooms, s.floor_current, s.floor_total,
           s.renovation, s.exposition_days, s.publish_date, s.sold_date, s.parsed_at
    FROM sold_ads s
    WHERE s.external_id IN (SELECT external_id FROM active_ads WHERE filter_id = 6 AND external_id IS NOT NULL)
    ORDER BY s.sold_date DESC NULLS LAST
""")
cols = [d[0] for d in cur.description]
rows = []
for row in cur.fetchall():
    d = dict(zip(cols, row))
    out = {}
    for k, v in d.items():
        if k in {'id', 'manualSort'} or v is None:
            continue
        out[k] = v.isoformat() if hasattr(v, 'isoformat') else v
    rows.append({'fields': out})
print(f'inserting {len(rows)} avans sold ads via external_id cross-link')
r = grist_post_records('Table3', rows)
print(f'  done: {r}')
cur.close(); conn.close()
