"""Inspect local PG schema and per-source/filter row counts."""
import psycopg2
conn = psycopg2.connect(host='127.0.0.1', port=5432, user='flipper', password='flipper_secret', dbname='flipper')
cur = conn.cursor()

# Columns of active_ads
print('=== active_ads columns ===')
cur.execute("""
    SELECT column_name, data_type FROM information_schema.columns
    WHERE table_name = 'active_ads' ORDER BY ordinal_position
""")
for col, dtype in cur.fetchall():
    print(f'  {col}  ({dtype})')

print()
print('=== active_ads by filter_id + source ===')
cur.execute("""
    SELECT filter_id, source, COUNT(*) FROM active_ads GROUP BY filter_id, source ORDER BY filter_id
""")
for fid, src, cnt in cur.fetchall():
    print(f'  filter_id={fid}  source={src}  count={cnt}')

print()
print('=== sold_ads columns ===')
cur.execute("""
    SELECT column_name, data_type FROM information_schema.columns
    WHERE table_name = 'sold_ads' ORDER BY ordinal_position
""")
for col, dtype in cur.fetchall():
    print(f'  {col}  ({dtype})')

print()
print('=== sold_ads by filter_id + source ===')
cur.execute("""
    SELECT filter_id, source, COUNT(*) FROM sold_ads GROUP BY filter_id, source ORDER BY filter_id
""")
for fid, src, cnt in cur.fetchall():
    print(f'  filter_id={fid}  source={src}  count={cnt}')

cur.close()
conn.close()
