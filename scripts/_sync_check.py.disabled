import psycopg2

conn = psycopg2.connect(host='127.0.0.1', port=5432, user='flipper', password='flipper_secret', dbname='flipper')
cur = conn.cursor()

for t in ['active_ads', 'sold_ads', 'houses']:
    cur.execute(f"SELECT source, COUNT(*) FROM {t} GROUP BY source ORDER BY source")
    rows = cur.fetchall()
    print(t, ':', ', '.join(f"{s}={n}" for s, n in rows))

print()
cur.execute("SELECT source, COUNT(*), MIN(sold_date), MAX(sold_date) FROM sold_ads GROUP BY source ORDER BY source")
for source, cnt, oldest, newest in cur.fetchall():
    print(f"  sold_ads.{source}: count={cnt}, oldest={oldest}, newest={newest}")

cur.close()
conn.close()
