// Quick check: local PG vs Grist Table1, and migration status
import pg from 'pg';

const client = new pg.Client({ host: '127.0.0.1', port: 5432, user: 'app', password: 'app', database: 'app_postgres' });
await client.connect();

for (const t of ['active_ads', 'sold_ads', 'houses']) {
  const r = await client.query(`SELECT source, COUNT(*)::int AS cnt FROM ${t} GROUP BY source ORDER BY source`);
  console.log(t, ':', r.rows.map(x => `${x.source}=${x.cnt}`).join(', '));
}
console.log('');

// Last sold_date per source
const r2 = await client.query(`SELECT source, COUNT(*)::int AS cnt, MIN(sold_date) AS oldest, MAX(sold_date) AS newest FROM sold_ads GROUP BY source ORDER BY source`);
console.log('sold_ads range:');
for (const row of r2.rows) {
  console.log('  ', row.source, 'count=', row.cnt, 'oldest=', row.oldest, 'newest=', row.newest);
}

await client.end();
