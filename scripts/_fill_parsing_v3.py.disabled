"""
Fill 5 empty Парсинг tables via POST /records (proven, ~30s for 5k).
Skips clear_table (they're already empty).
"""
import json
import sys
import time
import urllib.request
import urllib.parse
import psycopg2

GRIST_URL = 'http://localhost:8484'
GRIST_KEY = 'flipper_prod_c173df83d342e744aa1fa74bb80bd19a32f5f598d7e582c0c8d4561659290978'
DOC_ID = 'mDaHoGD6yahtxaqugwr5mK'

conn = psycopg2.connect(host='127.0.0.1', port=5432, user='flipper', password='flipper_secret', dbname='flipper')
cur = conn.cursor()

def grist_post_records(table, records):
    body = json.dumps({'records': records}).encode()
    req = urllib.request.Request(
        f'{GRIST_URL}/api/docs/{DOC_ID}/tables/{table}/records',
        data=body,
        headers={'Authorization': f'Bearer {GRIST_KEY}', 'Content-Type': 'application/json'},
        method='POST',
    )
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.loads(r.read())

def to_fields(d):
    out = {}
    for k, v in d.items():
        if k in {'id', 'manualSort'}:
            continue
        if v is None:
            continue
        if hasattr(v, 'isoformat'):
            out[k] = v.isoformat()
        else:
            out[k] = v
    return out

def bulk_insert(table, dicts, batch=500):
    added = 0
    t0 = time.time()
    for i in range(0, len(dicts), batch):
        chunk = [{'fields': to_fields(d)} for d in dicts[i:i+batch]]
        try:
            r = grist_post_records(table, chunk)
            added += len(r.get('records', []))
        except urllib.error.HTTPError as e:
            body = e.read().decode()
            print(f'   FAIL @ batch {i}: {e.code} {body[:200]}', flush=True)
            for j, rec in enumerate(chunk):
                try:
                    grist_post_records(table, [rec])
                    added += 1
                except urllib.error.HTTPError as e2:
                    body2 = e2.read().decode()
                    print(f'      bad row #{i+j}: {body2[:160]}', flush=True)
        elapsed = time.time() - t0
        rate = added / elapsed if elapsed > 0 else 0
        print(f'   {added}/{len(dicts)} ({rate:.0f}/s)', flush=True)
    return added

target = sys.argv[1] if len(sys.argv) > 1 else 'all'

if target in ('Table2', 'all'):
    print('=== Table2 Аванс (active, filter_id=6) ===', flush=True)
    cur.execute("""
        SELECT source, cian_id, external_id, url, house_id, cian_house_id, price, price_per_m2,
               area, rooms, floor_current, floor_total, metro_station, metro_walk_time,
               district, okrug, renovation, is_active, days_in_exposition, total_views,
               unique_views, publish_date, filter_id, parsed_at, updated_at
        FROM active_ads WHERE filter_id = 6 ORDER BY id
    """)
    cols = [d[0] for d in cur.description]
    rows = [dict(zip(cols, row)) for row in cur.fetchall()]
    print(f'  fetched {len(rows)} from local PG', flush=True)
    added = bulk_insert('Table2', rows)
    print(f'  DONE Table2: {added}', flush=True)

if target in ('Table3', 'all'):
    print('=== Table3 Аванс_Продано (sold for avans houses) ===', flush=True)
    cur.execute("""
        SELECT s.source, s.external_id, s.url, s.house_id, s.cian_house_id, s.price,
               s.price_per_m2, s.area, s.rooms, s.floor_current, s.floor_total,
               s.renovation, s.exposition_days, s.publish_date, s.sold_date, s.parsed_at
        FROM sold_ads s
        WHERE s.house_id IN (SELECT house_id FROM active_ads WHERE filter_id = 6 AND house_id IS NOT NULL)
        ORDER BY s.sold_date DESC NULLS LAST, s.id DESC LIMIT 5000
    """)
    cols = [d[0] for d in cur.description]
    rows = [dict(zip(cols, row)) for row in cur.fetchall()]
    print(f'  fetched {len(rows)}', flush=True)
    added = bulk_insert('Table3', rows)
    print(f'  DONE Table3: {added}', flush=True)

if target in ('Balans', 'all'):
    print('=== Balans (per-filter stats) ===', flush=True)
    FILTERS_DEF = {
        1: 'offers, max_year=2000, dists=23-132',
        2: 'offers, min_year=2000, dists=23-132',
        3: 'offers, max_year=2000, dists=13-22',
        4: 'offers, min_year=2000, dists=13-22',
        5: 'signals, опека',
        6: 'avans, Т-банк|запрет долги',
    }
    cur.execute("""
        SELECT filter_id, COUNT(*), AVG(price)::bigint, MIN(price), MAX(price)
        FROM active_ads GROUP BY filter_id ORDER BY filter_id
    """)
    rows = []
    for fid, cnt, avg, mn, mx in cur.fetchall():
        rows.append({
            'filter_id': fid,
            'name': FILTERS_DEF.get(fid, f'filter_{fid}'),
            'active_count': cnt,
            'avg_price': int(avg) if avg else None,
            'min_price': mn,
            'max_price': mx,
        })
    print(f'  fetched {len(rows)}', flush=True)
    added = bulk_insert('Balans', rows)
    print(f'  DONE Balans: {added}', flush=True)

if target in ('Offers_Parser', 'all'):
    print('=== Offers_Parser (active, filter_id IN 1,2,3,4) ===', flush=True)
    cur.execute("""
        SELECT source, cian_id, external_id, url, house_id, cian_house_id, price, price_per_m2,
               area, rooms, floor_current, floor_total, metro_station, metro_walk_time,
               district, okrug, renovation, is_active, days_in_exposition, total_views,
               unique_views, publish_date, filter_id, parsed_at, updated_at
        FROM active_ads
        WHERE filter_id IN (1, 2, 3, 4) ORDER BY filter_id, id
    """)
    cols = [d[0] for d in cur.description]
    rows = [dict(zip(cols, row)) for row in cur.fetchall()]
    print(f'  fetched {len(rows)}', flush=True)
    added = bulk_insert('Offers_Parser', rows)
    print(f'  DONE Offers_Parser: {added}', flush=True)

if target in ('Signals_Parser', 'all'):
    print('=== Signals_Parser (active, filter_id=5) ===', flush=True)
    cur.execute("""
        SELECT source, cian_id, external_id, url, house_id, cian_house_id, price, price_per_m2,
               area, rooms, floor_current, floor_total, metro_station, metro_walk_time,
