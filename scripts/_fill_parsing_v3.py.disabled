               unique_views, publish_date, filter_id, parsed_at, updated_at
        FROM active_ads WHERE filter_id = 5 ORDER BY id
    """)
    cols = [d[0] for d in cur.description]
    rows = [dict(zip(cols, row)) for row in cur.fetchall()]
    print(f'  fetched {len(rows)}', flush=True)
    added = bulk_insert('Signals_Parser', rows)
    print(f'  DONE Signals_Parser: {added}', flush=True)

cur.close()
conn.close()
print('ALL DONE', flush=True)
