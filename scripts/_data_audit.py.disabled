"""Audit what's actually in local PG for avans / signals / offers."""
import psycopg2
conn = psycopg2.connect(host='127.0.0.1', port=5432, user='flipper', password='flipper_secret', dbname='flipper')
cur = conn.cursor()

print('=== active_ads columns ===')
cur.execute("SELECT column_name FROM information_schema.columns WHERE table_name='active_ads' ORDER BY ordinal_position")
for col in [r[0] for r in cur.fetchall()]:
    print(f'  {col}')

print()
print('=== active_ads by filter_id ===')
cur.execute('SELECT filter_id, COUNT(*) FROM active_ads GROUP BY filter_id ORDER BY filter_id')
for fid, cnt in cur.fetchall():
    print(f'  filter_id={fid}  total={cnt}')

print()
print('=== is_active distribution ===')
cur.execute('SELECT is_active, COUNT(*) FROM active_ads GROUP BY is_active')
for ac, cnt in cur.fetchall():
    print(f'  is_active={ac}  count={cnt}')

print()
print('=== houses by source ===')
cur.execute('SELECT source, COUNT(*) FROM houses GROUP BY source')
for src, cnt in cur.fetchall():
    print(f'  source={src}  count={cnt}')

print()
print('=== sold_ads totals ===')
cur.execute('SELECT COUNT(*), MIN(sold_date), MAX(sold_date) FROM sold_ads')
for cnt, mn, mx in cur.fetchall():
    print(f'  total={cnt}  range={mn}..{mx}')

print()
print('=== filter_id=6 sample (avans) ===')
cur.execute("SELECT id, cian_id, house_id, filter_id, is_active FROM active_ads WHERE filter_id=6 LIMIT 10")
for row in cur.fetchall():
    print(f'  {row}')

print()
print('=== House table columns ===')
cur.execute("SELECT column_name FROM information_schema.columns WHERE table_name='houses' ORDER BY ordinal_position")
for col in [r[0] for r in cur.fetchall()]:
    print(f'  {col}')

cur.close(); conn.close()
