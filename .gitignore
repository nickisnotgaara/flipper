# Data dir (runtime data, debug scripts, dumps — всё генерируется локально)
data/
!data/.gitkeep
# N.B.: data/proxies.txt уже tracked — оставляем (нужен для парсеров).
# Если хотим убрать — `git rm --cached data/proxies.txt`.

# Parser output (runtime artifacts — JSON/XLSX produced by acquirer.py + filters/exporter).
# The parser regenerates these on every run; committing them bloats the repo
# (multi-hundred-MB all_advs_vtorichka.json et al.) and breaks git push.
# Source code (acquirer.py / filters.py / exporter.py / importer.py) is kept.
services/parsers/winners_sold/*.json
services/parsers/winners_sold/*.xlsx
!services/parsers/winners_sold/tests/

# Secrets / credentials dir
secrets/

# Root-level debug/scratch scripts (single underscore prefix in repo root).
# N.B.: `/_*.py` matches only at repo root (not services/parsers/_common.py).
/_*.py
/inspect_recovered.py
/sample_test.jsonl

# Debug / temporary scripts (временные дебаг-файлы)
_tmp_*.py
scripts/_tmp/
scripts/_*.py
scripts/_*.sql
scripts/_*.ps1
data/_*.py
data/_*.json
data/_*.dump

# Archive (legacy code, переносим осознанно в Фазе 3)
archive/

