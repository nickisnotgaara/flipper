# Flipper Environment Configuration
# Copy this file to .env and fill in your actual values

# ═══ FIRECRAWL ═══════════════════════════════════════════════════════════════
# API key (or "local" for self-hosted Firecrawl without auth)
FIRECRAWL_API_KEY=local

# Self-hosted Firecrawl URL (docker-compose переопределяет через PARSER_FIRECRAWL_BASE_URL)
FIRECRAWL_BASE_URL=http://flippercrawl-api-1:3002
# Если Firecrawl в той же Docker-сети firecrawl_backend:
# PARSER_FIRECRAWL_BASE_URL=http://flippercrawl-api-1:3002

# ═══ GOOGLE SHEETS ═══════════════════════════════════════════════════════════
# Spreadsheet ID (из URL: docs.google.com/spreadsheets/d/{ID})
SPREADSHEET_ID=your-spreadsheet-id

# Path to Google Service Account credentials JSON
CREDENTIALS_PATH=/app/credentials.json

# ═══ DATABASE (PostgreSQL) ═══════════════════════════════════════════════════
# Пароль для PostgreSQL user "flipper" (используется в docker-compose)
POSTGRES_PASSWORD=flipper_secret

# DATABASE_URL — URL подключения. Приоритет — Docker:
#   Docker:   postgresql+asyncpg://flipper:flipper_secret@app_postgres:5432/flipper
#   Native:   postgresql+asyncpg://flipper:flipper_secret@127.0.0.1:5432/flipper
#
# По умолчанию (если переменная не задана) используется Docker-вариант.
# Чтобы переключиться на локальный PostgreSQL — раскомментируйте строку ниже:
# DATABASE_URL=postgresql+asyncpg://flipper:flipper_secret@127.0.0.1:5432/flipper
DATABASE_URL=postgresql+asyncpg://flipper:flipper_secret@app_postgres:5432/flipper

# Одноразовая настройка нативного PostgreSQL (запустить ОДИН РАЗ от postgres):
#   psql -U postgres -f scripts/setup_native_postgres.sql
# Или через PowerShell:
#   & "C:\Program Files\PostgreSQL\18\bin\psql.EXE" -U postgres -c "CREATE ROLE flipper LOGIN PASSWORD 'flipper_secret' SUPERUSER;"
#   & "C:\Program Files\PostgreSQL\18\bin\psql.EXE" -U postgres -c "CREATE DATABASE flipper OWNER flipper;"

# ═══ TELEGRAM ════════════════════════════════════════════════════════════════
# Бот для уведомлений (Signal, Продано, Cookie error)
TG_BOT_TOKEN=your-telegram-bot-token
TG_CHAT_ID=your-telegram-chat-id

# ═══ COOKIE MANAGER ═════════════════════════════════════════════════════════
# Внутренний URL (контейнер → контейнер)
COOKIE_MANAGER_URL=http://cookie_manager:8000
COOKIE_CHECK_INTERVAL=1800

# Публичный URL NoVNC (для ссылки в Telegram при "Куки слетели")
# Подставьте IP вашего сервера: curl -4 ifconfig.me
NOVNC_PUBLIC_URL=http://YOUR_SERVER_IP:8080/vnc.html

# ═══ PARSER ══════════════════════════════════════════════════════════════════
# Параллельных воркеров (зависит от мощности Firecrawl)
PARSER_CONCURRENCY=50

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ═══ PROXIES ═════════════════════════════════════════════════════════════════
# Резидентские прокси для парсинга списков Cian — из файла data/proxies.txt
# Формат файла: host:port:user:pass (по одному на строку)
# Если файл пустой или отсутствует — прямой запрос без прокси

# HTML → Markdown сервис (опционально)
HTML_TO_MARKDOWN_URL=http://html_to_markdown:8080

# ═══ SCHEDULER (compose run из контейнера) ═══════════════════════════════════
# Если docker inspect не находит bind корня репозитория — абсолютный путь к проекту
# на машине с Docker (Linux: /srv/flipper, Windows: C:/Users/you/Desktop/flipper)
# SCHEDULER_HOST_BIND_ROOT=

# ═══ WEEKLY SECONDARY PARSERS ═══════════════════════════════════════════════
# Расписание еженедельных парсеров winners_sold и domclick_sold.
# Остальные парсеры (cian_sold, flatinfo_houses) — только вручную через
# `docker compose run --rm <service>`.
#
# WEEKLY_RUN_DAY_OF_WEEK: sun|mon|tue|wed|thu|fri|sat
WEEKLY_RUN_DAY_OF_WEEK=sun
WEEKLY_WINNERS_HOUR=6
WEEKLY_DOMCLICK_HOUR=7

# Таймаут одного weekly-запуска (секунды)
SCHEDULER_WEEKLY_TIMEOUT=7200

# ═══ DAILY PIPELINE (ежедневный re-fetch активных объявлений) ═══════════
# Час MSK для ежедневного прогона pipeline_runner (--fetch-missing).
# По умолчанию 02:00 — пока cian_active парсер спит (10:00 / 18:00).
PIPELINE_DAILY_HOUR=2

# Таймаут pipeline_runner (секунды). Полный прогон 3-4к ads через
# flippercrawl обычно занимает 30-90 мин; ставим запас.
SCHEDULER_PIPELINE_TIMEOUT=10800

# Режим pipeline_runner. fetch-missing = все активные (production).
# recent N = только N самых свежих (для теста/прогрева).
# ids FILE = конкретные external_id (для backfill).
PIPELINE_MODE=fetch-missing

# Писать ли Excel-выгрузку (1/0) для парсеров, где она поддерживается
WINNERS_DUMP_XLSX=1
DOMCLICK_DUMP_XLSX=1
FLATINFO_DUMP_XLSX=1
