# Build-only Dockerfile for the static frontend (web/next/).
#
# Зачем: раньше web/ жил в `docker compose --profile dev up` рядом с api,
# и любая правка фронта требовала рестарта контейнера. Теперь фронт
# собирается отдельно (next export → ./out/) и деплоится как статика.
# Этот Dockerfile — опциональный build-runner, если собирать в CI/Docker
# удобнее, чем напрямую `npm ci && npm run build`.
#
# Использование:
#   docker build -f web/next/Dockerfile.build -t flipper-web-build web/next
#   docker create --name wb flipper-web-build
#   docker cp wb:/app/out ./out
#   docker rm wb
#
FROM node:20-alpine AS builder

ENV TZ=Europe/Moscow
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

WORKDIR /app

# Кешируем npm ci отдельно от исходников
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund

# Копируем только то, что нужно для сборки
COPY next.config.mjs ./
COPY tsconfig.json ./
COPY postcss.config.js ./
COPY tailwind.config.ts ./
COPY app ./app
COPY components ./components
COPY lib ./lib
COPY public ./public

# next build → next export кладёт статику в ./out (см. next.config.mjs)
RUN npm run build

# ---- Runtime stage: просто nginx-подобный сервер для раздачи ./out ----
# На проде чаще всего используют Vercel/Cloudflare Pages/nginx напрямую,
# но если хочется «всё в одном контейнере» — этот stage пригодится.
FROM nginx:1.27-alpine AS runtime
COPY --from=builder /app/out /usr/share/nginx/html
# SPA fallback (на всякий случай, хоть у нас и trailingSlash=true) +
# отключаем кеш для index.html, чтобы CDN всегда подхватывал свежий билд.
RUN printf 'server { listen 8080; root /usr/share/nginx/html; index index.html; \
location ~* \\.(?:html)$ { add_header Cache-Control "no-cache"; } \
location / { try_files $uri $uri/ /index.html; } }\n' > /etc/nginx/conf.d/default.conf
EXPOSE 8080
