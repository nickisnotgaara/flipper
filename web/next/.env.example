# Frontend build-time env (Flipper web/next, 2026-08).
#
# Скопируй в .env.local для локальной сборки или задай в CI:
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* — это значения, которые попадают в браузерный бандл.
# Их нельзя использовать для секретов, но для базового URL API — самое то.

# URL FastAPI-бэка, к которому ходит фронт.
#   Локальная сборка против Docker-стека:  http://localhost:8001
#   Локальная сборка против native-бэка:   http://127.0.0.1:8000
#   Прод (отдельный домен API):            https://api.flipper.example.com
#   Прод (reverse-proxy, тот же домен):    https://flipper.example.com
NEXT_PUBLIC_API_BASE=http://localhost:8001
